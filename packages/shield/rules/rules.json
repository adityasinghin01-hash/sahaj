  "patterns": {
    "P1": { "phase": 1, "id": "pattern.P1", "level": "red", "scam_type": "otp_theft",
      "description": "OTP SMS arrives while a call with an unknown number is active, or within 5 minutes after it ended",
      "caller_types": ["mobile_10", "international", "series_140", "unknown"],
      "window_after_call_ms": 300000,
      "reason": { "hi": "अनजान नंबर से कॉल चल रही है और उसी समय OTP आया — यह OTP किसी को न बताएं, कॉल काट दें", "en": "An OTP arrived during a call with an unknown number — do not read it out, hang up" } },
    "P5": { "phase": 1, "id": "pattern.P5",
      "description": "SMS with a link + bank/electricity/courier words + 10-digit (or international) sender -> red; only one of the two signals -> yellow. Trusted senders (business header / saved contact) only fire yellow when a link is a shortener, look-alike or punycode.",
      "risky_sender_types": ["mobile_10", "international"],
      "red": { "level": "red", "reason": { "hi": "आम मोबाइल नंबर से बैंक/बिजली/कूरियर के नाम पर लिंक भेजा गया है — लिंक न खोलें", "en": "Link about bank/electricity/courier sent from an ordinary mobile number — do not open it" } },
      "yellow": { "level": "yellow", "reason": { "hi": "संदेश में लिंक है और एक संदिग्ध संकेत है — लिंक खोलने से पहले पूछ लें", "en": "Message has a link plus one warning sign — check before opening" } } },
    "P2": {
      "phase": 2,
      "id": "pattern.P2",
      "level": "red",
      "scam_type": "digital_arrest",
      "description": "Video or WhatsApp call with an unknown number running 10 minutes or longer",
      "caller_types": ["mobile_10", "international", "series_140", "unknown"],
      "min_duration_ms": 600000,
      "min_duration_seconds": 600,
      "require_video_or_whatsapp": true,
      "reason": {
        "hi": "लंबे समय से अनजान नंबर से वीडियो कॉल चल रही है — सरकारी अफसर या पुलिस कभी वीडियो कॉल पर पैसे नहीं मांगते",
        "en": "Long video call with an unknown number — police and officers never ask for money on a video call"
      }
    },
    "P3": {
      "phase": 2,
      "id": "pattern.P3",
      "level": "red",
      "scam_type": "remote_access",
      "description": "APK file sent in a message or WhatsApp, or a non-system app installed outside the Play Store within 24 hours",
