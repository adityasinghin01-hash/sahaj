{
  "version": "1.0.0",
  "updated": "2026-11-14",
  "sources": [
    { "id": "rbi_beaware_2022", "title": "RBI 'BE(A)WARE' booklet on modus operandi of financial frauds (2022)", "url": "https://rbi.org.in/commonperson/English/Scripts/BEAWARE.aspx" },
    { "id": "state_police_advisories", "title": "State police / I4C cyber-crime advisories (digital arrest, electricity cut, parcel/customs, task jobs, APK invites)", "url": "https://cybercrime.gov.in" },
    { "id": "trai_headers_1600", "title": "TRAI TCCCPR 2018 + directions on SMS header suffixes (-P/-S/-T/-G), 140-series telemarketing and 1600-series BFSI service calls", "url": "https://www.trai.gov.in" }
  ],
  "regex_dialect": "Strings compiled with new RegExp(pattern, flags) in JS and Pattern.compile in Java/Kotlin. Allowed flags: 'i' only (map to CASE_INSENSITIVE). No lookbehind, no named groups, no \\p{..}/\\u{..} escapes. Lookahead (?= / (?! and non-capturing (?: are allowed.",
  "normalize": {
    "note": "Phrase matching: lowercase; Devanagari digits U+0966-U+096F -> 0-9; drop U+200C/U+200D; every char that is not [a-z0-9] or Devanagari U+0900-U+0963,U+0966-U+097F becomes a space; collapse spaces; a phrase hits when ' '+phrase+' ' occurs in ' '+text+' '. Phrases are normalized the same way.",
    "number_strip_pattern": "[\\s().-]"
  },

  "sender": {
    "rules": [
      { "id": "sender.business_header", "type": "business_header", "pattern": "^[A-Z]{2}-[A-Z0-9]{3,6}(-[PSTG])?$", "flags": "i", "score": 0,
        "reason": { "hi": "संदेश रजिस्टर्ड बिज़नेस हेडर से आया है", "en": "Sent from a registered business header" } },
      { "id": "sender.mobile_10", "type": "mobile_10", "pattern": "^(\\+91|0091|91|0)?[6-9][0-9]{9}$", "flags": "", "score": 0,
        "reason": { "hi": "संदेश किसी आम 10 अंकों वाले मोबाइल नंबर से आया है, बैंक या कंपनी से नहीं", "en": "Sent from an ordinary 10-digit mobile number, not a bank/company header" } },
      { "id": "sender.international", "type": "international", "pattern": "^(\\+|00)(?!91)[1-9][0-9]{6,14}$", "flags": "", "score": 15,
        "reason": { "hi": "संदेश विदेशी नंबर से आया है", "en": "Sent from an international number" } },
      { "id": "sender.short_code", "type": "short_code", "pattern": "^[0-9]{3,6}$", "flags": "", "score": 0,
        "reason": { "hi": "संदेश शॉर्ट कोड से आया है", "en": "Sent from a short code" } }
    ],
    "mobile_claims_brand": { "id": "sender.mobile_claims_brand", "score": 15,
      "reason": { "hi": "बैंक/बिजली/कूरियर की बात आम मोबाइल नंबर से की गई है — असली कंपनी ऐसे नंबर से SMS नहीं भेजती", "en": "Bank/electricity/courier message from an ordinary mobile number — real companies use registered headers" } },
    "saved_contact": { "id": "sender.saved_contact", "score": -10,
      "reason": { "hi": "भेजने वाला आपके फ़ोन में सेव है", "en": "Sender is a saved contact" } }
  },

  "caller": {
    "rules": [
      { "id": "caller.series_1600", "type": "series_1600", "pattern": "^(\\+91|0091|91|0)?1600[0-9]{6}$", "flags": "", "score": -10,
        "reason": { "hi": "1600 वाला रजिस्टर्ड बैंक नंबर — असली बैंक/बीमा कंपनी की कॉल", "en": "1600-series registered bank number — official bank/insurer caller" } },
      { "id": "caller.series_140", "type": "series_140", "pattern": "^(\\+91|0091|91|0)?140[0-9]{7}$", "flags": "", "score": 5,
        "reason": { "hi": "140 वाला नंबर — विज्ञापन/टेलीमार्केटिंग कॉल", "en": "140-series number — telemarketing call" } },
      { "id": "caller.mobile_10", "type": "mobile_10", "pattern": "^(\\+91|0091|91|0)?[6-9][0-9]{9}$", "flags": "", "score": 5,
        "reason": { "hi": "अनजान 10 अंकों वाले मोबाइल नंबर से कॉल", "en": "Call from an unknown 10-digit mobile number" } },
      { "id": "caller.international", "type": "international", "pattern": "^(\\+|00)(?!91)[1-9][0-9]{6,14}$", "flags": "", "score": 20,
        "reason": { "hi": "विदेशी नंबर से कॉल", "en": "Call from an international number" } }
    ]
  },

  "otp": {
    "id": "otp.present",
    "keyword_pattern": "\\b(otp|one[ -]?time[ -]?(password|passcode|pin)|verification( code)?|security code|auth(entication)? code|login code|code|do not share|don'?t share|never share|share na kar[ea]i?n?)\\b|ओटीपी|वन टाइम पासवर्ड|सत्यापन( कोड)?|कोड|साझा न कर|शेयर न कर",
    "keyword_flags": "i",
    "number_pattern": "(^|[^0-9A-Za-z<_])([0-9]{4,8})(?![0-9A-Za-z_])",
    "number_flags": "",
    "number_group": 2,
    "currency_before_pattern": "(rs\\.?|inr|₹|mrp)\\s*$",
    "currency_before_flags": "i",
    "window_chars": 60,
    "reason": { "hi": "इस संदेश में OTP है — OTP किसी को न बताएं", "en": "This message contains an OTP — never share it" }
  },

  "mask": {
    "note": "Applied in this order. URLs -> <URL:host> (4+ digit runs in host -> '#', ' [.apk]' appended for APK links); then every step below EXCEPT the last (1600, intl, mobile) with group 1 (left boundary) kept; then OTP digits -> otp_token; then the last step; finally any remaining 4+ digit run -> <NUM> (the lookahead keeps the literal '1600' inside the <1600_NUMBER> token).",
    "url_token_prefix": "<URL:",
    "url_token_suffix": ">",
    "apk_marker": " [.apk]",
    "otp_token": "******",
    "steps": [
      { "id": "mask.series_1600", "token": "<1600_NUMBER>", "pattern": "(^|[^0-9+])(((\\+91|0091|91|0)[ -]?)?1600[ -]?[0-9]{3}[ -]?[0-9]{3})(?![0-9])", "flags": "" },
      { "id": "mask.international", "token": "<INTL>", "pattern": "(^|[^0-9+])((\\+|00)(?!91)[1-9][0-9 -]{6,16}[0-9])(?![0-9])", "flags": "" },
      { "id": "mask.mobile_10", "token": "<MOBILE_10>", "pattern": "(^|[^0-9+])(((\\+91|0091|91|0)[ -]?)?[6-9][0-9]{4}[ -]?[0-9]{5})(?![0-9])", "flags": "" },
      { "id": "mask.digits", "token": "<NUM>", "pattern": "(^|[^0-9])([0-9]{4,})(?!_NUMBER>)", "flags": "" }
    ]
  },

  "links": {
    "url_pattern": "(^|[^A-Za-z0-9@._-])((?:https?://|www\\.)[^\\s<>\"']+|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:com|in|net|org|info|xyz|ly|gd|gy|co|io|me|top|site|online|live|club|app|link|sbi|bank|gov|nic|tk|ml|ga|cf|gq|cc|biz|shop|store|vip|icu|buzz|cyou|click|fun|win|loan|work|today|support|help|services|page|ws|at|to|id|ru|cn|pw|su|us|uk|ae)(?![A-Za-z0-9-])(?:[/?#][^\\s<>\"']*)?)",
    "url_flags": "i",
    "url_group": 2,
    "trailing_punct_pattern": "[.,;:!?)\\]}'\"]+$",
    "multi_part_suffixes": ["co.in", "gov.in", "nic.in", "org.in", "net.in", "ac.in", "edu.in", "res.in", "firm.in", "gen.in", "ind.in", "bank.in", "fin.in", "co.uk", "org.uk", "com.au", "co.za"],
    "present": { "id": "link.present", "score": 5,
      "reason": { "hi": "संदेश में लिंक है", "en": "Message contains a link" } },
    "shortener": { "id": "link.shortener", "score": 25,
      "domains": ["bit.ly", "tinyurl.com", "cutt.ly", "is.gd", "t.ly", "rb.gy", "goo.gl", "ow.ly", "t.co", "shorturl.at", "tiny.cc", "s.id", "v.gd", "buff.ly", "rebrand.ly", "bl.ink", "short.gy", "shorte.st", "adf.ly", "clck.ru", "urlz.fr", "lnkd.in", "tiny.one", "surl.li", "u.to"],
      "reason": { "hi": "छोटा किया हुआ (short) लिंक — असली जगह छिपी है", "en": "Shortened link hides the real destination" } },
    "apk": { "id": "link.apk", "score": 60, "force_level": "red",
      "pattern": "\\.apk([^A-Za-z0-9]|$)|एपीके",
      "flags": "i",
      "reason": { "hi": ".apk फ़ाइल — इसे इंस्टॉल करने से फ़ोन हैक हो सकता है", "en": ".apk file — installing it can take over the phone" } },
    "look_alike": { "id": "link.look_alike", "score": 40,
      "reason": { "hi": "लिंक असली कंपनी जैसा दिखता है पर उसकी आधिकारिक वेबसाइट नहीं है", "en": "Link imitates a brand but is not its official website" } },
    "punycode": { "id": "link.punycode", "score": 40,
      "reason": { "hi": "लिंक में छिपे हुए विदेशी अक्षर (xn--) हैं", "en": "Link uses disguised characters (punycode xn--)" } },
