# Only server runtime values. Keep actual secrets in .env.local / Vercel env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SARVAM_TOOL_BEARER=
SARVAM_HOOK_SECRET=
MISSEDCALL_HOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
CRON_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_RECORDING_CALLBACK_URL=
SARVAM_APP_ID=
SARVAM_DEPLOYMENT_ID=
SARVAM_AGENT_NUMBER=
TELECMI_APP_ID=
TELECMI_VIRTUAL_NUMBER=
# Must match the consent version actually presented and recorded; no inferred grants.
CALL_CONSENT_VERSION=
WEBHOOK_ENCRYPTION_KEY=
IDENTITY_HASH_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
MAINTENANCE_KILL=false

# Optional future stage; do not use for emergency/safety-critical processing until reviewed.
PRUNE_ENABLED=false
PRUNE_API_KEY=

# ---- Atlas runtime (Phase 3). Names only; values live in .env.local / Vercel env.
# DATABASE_URL (above) must be a direct or session-mode connection: the checkpoint fence uses session advisory locks.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
SIGNING_KEY_ID=

# ---- Provider dispatch (Phase 3 runtime). Every *_ENABLED flag must be exactly "true" to take effect.
PROVIDER_DISPATCH_ENABLED=false
SARVAM_OUTBOUND_ENABLED=false
TWILIO_OUTBOUND_ENABLED=false
WHATSAPP_OUTBOUND_ENABLED=false
# Comma-separated hosts (or *.suffix) that serve this backend's provider webhooks and TwiML. HTTPS only, no ports.
PROVIDER_WEBHOOK_HOSTS=
# 64 hex chars. Key for provider_identities.contact_ciphertext; must equal the key used by contact registration.
CONTACT_ENCRYPTION_KEY=
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Integer app version published in Sarvam. Do not guess.
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_OUTBOUND_WEBHOOK_URL=
TWILIO_FROM_NUMBER=
TWILIO_RESPONDER_TWIML_URL=
WHATSAPP_ACCESS_TOKEN=
# Explicit Graph API version such as v23.0; confirm in Meta docs. Never defaulted.
WHATSAPP_GRAPH_VERSION=

# ---- Recording retrieval and purge
RECORDING_RETRIEVAL_ENABLED=false
SARVAM_RECORDING_RETRIEVAL=false
RECORDING_PURGE_ENABLED=false
# 1..100 rows per tick; defaults to 25 when empty.
RECORDING_PURGE_LIMIT=