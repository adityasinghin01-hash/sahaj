{
  "expo": {
    "name": "Sahaj",
    "slug": "sahaj-child",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sahaj",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDF9F8"
      },
      "package": "app.sahaj.child",
      "permissions": [
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "shield-quiet-v2",
          "sounds": [
            "./assets/sounds/shield_alarm.wav"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "394cadea-2e19-40f9-b08e-2605ff5ba87d"
      }
    },
    "owner": "aditya_fdavld"
  }
}
